# EMFT — production server configuration (Apache). Ignored by GitHub Pages.
# Pairs with the Content-Security-Policy meta tag each page carries: the meta
# tag protects the page wherever it is served, and these headers add what a
# meta tag cannot (frame-ancestors, HSTS, MIME sniffing, permissions).

# --- HTTPS and one canonical host -------------------------------------------
RewriteEngine On
# Behind a CDN or load balancer that terminates TLS, %{HTTPS} is "off" for
# every request; the X-Forwarded-Proto condition covers that case.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://www.emergingmarketft.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^emergingmarketft\.com$ [NC]
RewriteRule ^ https://www.emergingmarketft.com%{REQUEST_URI} [L,R=301]

# --- Security headers ---------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # frame-ancestors cannot be set from a meta tag, so it lives here.
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header unset X-Powered-By
  Header unset Server
</IfModule>
ServerSignature Off

# --- No directory listings, no dotfiles, no editor or backup leftovers --------
Options -Indexes
<FilesMatch "^\.|~$|\.(bak|old|orig|sql|zip|tar|gz|log|ini|env)$">
  Require all denied
</FilesMatch>

# --- Caching: assets are stamped per deploy, HTML is not ----------------------
# mod_expires never overrides an Expires header an application already set,
# so Moodle under /elearning/ keeps its own no-cache behaviour.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# --- Old site: map the URLs people still hold to the new pages ---------------
# Fill these in from the old site's analytics or sitemap before cutover, e.g.
# Redirect 301 /about-us/            /about.html
# Redirect 301 /contact-us/          /contact.html
# Redirect 301 /courses/             /programs.html
# The Learning Portal at /elearning/ is untouched by any rule above.
