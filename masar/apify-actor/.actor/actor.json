{
    "actorSpecification": 1,
    "name": "course-catalogue-scraper",
    "title": "Course catalogue scraper (bilingual import)",
    "description": "Crawls a course directory or school site, extracts course listings (schema.org JSON-LD first, metadata fallback), optionally translates each row into Arabic with Claude, and outputs rows matching the Masar import spreadsheet.",
    "version": "0.1",
    "buildTag": "latest",
    "input": "./input_schema.json",
    "dockerfile": "../Dockerfile",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Courses",
            "views": {
                "overview": {
                    "title": "Overview",
                    "transformation": {
                        "fields": ["title", "school", "start", "price", "currency", "subject", "format", "title_ar", "source_url"]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "title": {"label": "Course"},
                            "school": {"label": "School"},
                            "start": {"label": "Starts"},
                            "price": {"label": "Fee"},
                            "title_ar": {"label": "Arabic title"},
                            "source_url": {"label": "Source", "format": "link"}
                        }
                    }
                }
            }
        }
    }
}
